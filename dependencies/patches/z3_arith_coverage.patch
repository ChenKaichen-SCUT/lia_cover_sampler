+inline Z floor_sum(Z n, Z m, Z a, Z b) {
+    if (n < 0 || m <= 0)
+        throw std::invalid_argument("floor_sum domain");
+    Z result = 0;
+    while (true) {
+        Z qa = floor_div(a, m), qb = floor_div(b, m);
+        result += qa * n * (n - 1) / 2 + qb * n;
+        a -= qa * m;
+        b -= qb * m;
