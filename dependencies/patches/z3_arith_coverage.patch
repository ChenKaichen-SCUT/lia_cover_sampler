+    return desired ? ones : Z(n - ones);
+}
+inline std::optional<Z> find_bit_hit(const Z &a, const Z &b, unsigned j, bool desired, Z L, Z U, Z rank = 0) {
+    Z count = count_bit_hits(a, b, j, desired, L, U);
