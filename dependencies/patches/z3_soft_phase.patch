+    m_soft_lookup_seconds=0;m_soft_events.clear();
+    for(unsigned i=0;i<n;++i) {
+        m_soft_preferences.push_back(soft_phase_entry(m,atoms[i],groups[i],truth[i]!=0));
+        auto &e=m_soft_preferences.back();m_rewriter(e.original,e.normalized);
+        expr* inner=nullptr;
